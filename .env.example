# ============================================================
# FraudGuard Environment Configuration (Template)
# ============================================================
# Copy this template to .env for local configuration.
# Do NOT store production secrets or credentials in version control.

# Backend Port (defaults to 5000)
PORT=5000

# Database Connection URL
# Local Development: Leave blank to use automatic local SQLite (backend/fraudguard.db)
# Production / Staging: Provide PostgreSQL connection string (psycopg2 required)
# DATABASE_URL=postgresql://user:password@localhost:5432/fraudguard
DATABASE_URL=

# Flask Environment & Debugging Mode
# Local Development: Set FLASK_DEBUG=1 for reloaders on 127.0.0.1 (never bind 0.0.0.0 in debug mode)
# Production: MUST be set to 0. Use a WSGI server (Gunicorn via backend/Procfile)
FLASK_ENV=development
FLASK_DEBUG=0

# CORS Allowed Origins
# Comma-separated list of origins permitted to call the REST API.
# Local Development default: http://localhost:5173,http://127.0.0.1:5173
# Production: Set to your exact production frontend domain, e.g. https://fraudguard.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Administrative API Key (Optional in local dev, REQUIRED for staging/production)
# Protects /api/reset-demo, /api/clusters/<id>/action, and administrative operations.
# Leave blank ONLY for zero-config local demo evaluation.
ADMIN_API_KEY=

# Frontend API URL (defaults to http://127.0.0.1:5000 in Vite development)
VITE_API_URL=http://127.0.0.1:5000
